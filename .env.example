# Backend API manzili (oxirida /api bilan)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Rasm/media manzili (backend `/uploads/...` yo‘llarini to‘ldirish uchun)
NUXT_PUBLIC_MEDIA_BASE=http://localhost:8000

# Public saytning absolute manzili (canonical, OG, sitemap.xml va robots.txt uchun)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# SSR ichidagi so'rovlar uchun ichki API manzili. Lokalda BO'SH qoldiring —
# u holda NUXT_PUBLIC_API_BASE ishlatiladi. Prodda: http://backend:8000/api
NUXT_API_INTERNAL_BASE=
